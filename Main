import asyncio
    import sqlite3
    import json
    import random
    import os
    from datetime import datetime, timedelta
    from aiogram import Bot, Dispatcher, types, F
    from aiogram.filters import CommandStart
    from aiogram.types import WebAppInfo, InlineKeyboardMarkup, InlineKeyboardButton, LabeledPrice
    from aiohttp import web

    # ================= КОНФИГУРАЦИЯ =================
    TOKEN = os.getenv("BOT_TOKEN")  # Токен теперь берется из переменных окружения
    BASE_URL = os.getenv("RENDER_EXTERNAL_URL") # Render сам подставит сюда свою ссылку

    # 👇 ТВОЙ TELEGRAM ID УЖЕ ВСТАВЛЕН ЗДЕСЬ!
    ADMIN_ID = 6409224342 
    # ================================================

    bot = Bot(token=TOKEN)
    dp = Dispatcher()

    def init_db():
        conn = sqlite3.connect("database.db")
        cursor = conn.cursor()
        cursor.execute("""
            CREATE TABLE IF NOT EXISTS users (
                user_id INTEGER PRIMARY KEY,
                username TEXT,
                stars_balance INTEGER DEFAULT 0,
                last_free_spin TEXT,
                inventory TEXT DEFAULT '[]'
            )
        """)
        conn.commit()
        conn.close()

    init_db()

    ITEMS = [
        {"id": 1, "name": "Огненный Демон", "icon": "👹🔥", "color": "#ff414d"},
        {"id": 2, "name": "Ключ Любви", "icon": "🔑💖", "color": "#fd79a8"},
        {"id": 3, "name": "Сонная Лягушка", "icon": "🐸💤", "color": "#2ecc71"},
        {"id": 4, "name": "Праздничный Мишка", "icon": "🧸🎉", "color": "#e28743"},
        {"id": 5, "name": "Алмазный Сундук", "icon": "🧰💎", "color": "#0984e3"},
    ]

    def get_user(user_id, username=""):
        conn = sqlite3.connect("database.db")
        cursor = conn.cursor()
        cursor.execute("SELECT * FROM users WHERE user_id = ?", (user_id,))
        user = cursor.fetchone()
        if not user:
            cursor.execute("INSERT INTO users (user_id, username) VALUES (?, ?)", (user_id, username))
            conn.commit()
            cursor.execute("SELECT * FROM users WHERE user_id = ?", (user_id,))
            user = cursor.fetchone()
        conn.close()
        
        # Декодируем инвентарь и добавляем уникальный UUID для каждого предмета, если его нет
        raw_inventory = json.loads(user[4])
        inventory = []
        for item in raw_inventory:
            if "uuid" not in item:
                item["uuid"] = f"{item['id']}_{random.randint(100000, 999999)}"
            if "status" not in item:
                item["status"] = "in_inventory" # "in_inventory" или "claimed"
            inventory.append(item)
            
        return {
            "user_id": user[0],
            "username": user[1],
            "stars_balance": user[2],
            "last_free_spin": user[3],
            "inventory": inventory
        }

    def update_user_balance(user_id, amount):
        conn = sqlite3.connect("database.db")
        cursor = conn.cursor()
        cursor.execute("UPDATE users SET stars_balance = stars_balance + ? WHERE user_id = ?", (amount, user_id))
        conn.commit()
        conn.close()

    def update_user_spin_time(user_id):
        conn = sqlite3.connect("database.db")
        cursor = conn.cursor()
        now_str = datetime.now().isoformat()
        cursor.execute("UPDATE users SET last_free_spin = ? WHERE user_id = ?", (now_str, user_id))
        conn.commit()
        conn.close()

    def add_to_inventory(user_id, item):
        user = get_user(user_id)
        inv = user["inventory"]
        item_to_add = item.copy()
        item_to_add["uuid"] = f"{item['id']}_{random.randint(100000, 999999)}"
        item_to_add["status"] = "in_inventory"
        inv.append(item_to_add)
        
        conn = sqlite3.connect("database.db")
        cursor = conn.cursor()
        cursor.execute("UPDATE users SET inventory = ? WHERE user_id = ?", (json.dumps(inv), user_id))
        conn.commit()
        conn.close()

    def update_inventory_item_status(user_id, item_uuid, status):
        user = get_user(user_id)
        inv = user["inventory"]
        for item in inv:
            if item.get("uuid") == item_uuid:
                item["status"] = status
                break
                
        conn = sqlite3.connect("database.db")
        cursor = conn.cursor()
        cursor.execute("UPDATE users SET inventory = ? WHERE user_id = ?", (json.dumps(inv), user_id))
        conn.commit()
        conn.close()

    # --- WEB API ---
    async def handle_index(request):
        return web.FileResponse("index.html")

    async def get_status_api(request):
        user_id = int(request.rel_url.query.get("user_id", 0))
        user = get_user(user_id)
        
        can_free = True
        cooldown = 0
        if user["last_free_spin"]:
            last_spin_dt = datetime.fromisoformat(user["last_free_spin"])
            time_passed = datetime.now() - last_spin_dt
            if time_passed < timedelta(days=1):
                can_free = False
                cooldown = int((timedelta(days=1) - time_passed).total_seconds())

        return web.json_response({
            "can_free_spin": can_free,
            "cooldown_seconds": cooldown,
            "stars_balance": user["stars_balance"],
            "inventory": user["inventory"]
        })

    async def spin_api(request):
        data = await request.json()
        user_id = data.get("user_id")
        spin_type = data.get("type")
        
        user = get_user(user_id)
        
        if spin_type == "free":
            if user["last_free_spin"]:
                last_spin_dt = datetime.fromisoformat(user["last_free_spin"])
                if datetime.now() - last_spin_dt < timedelta(days=1):
                    return web.json_response({"error": "Бесплатная крутка недоступна!"}, status=400)
            update_user_spin_time(user_id)
        else:
            if user["stars_balance"] < 150:
                return web.json_response({"error": "Недостаточно Звёзд на балансе!"}, status=400)
            update_user_balance(user_id, -150)
            
        prize = random.choices(ITEMS, weights=[10, 15, 35, 30, 10], k=1)[0]
        add_to_inventory(user_id, prize)
        return web.json_response({"success": True, "prize": prize})

    # API для пополнения баланса Звезд
    async def create_invoice_api(request):
        data = await request.json()
        user_id = int(data.get("user_id"))
        stars_amount = int(data.get("amount", 150)) # По умолчанию 150 звезд
        
        invoice_link = await bot.create_invoice_link(
            title=f"Пополнение: {stars_amount} ⭐️",
            description=f"Покупка {stars_amount} звезд для баланса рулетки",
            payload=f"stars_buy_{user_id}_{stars_amount}",
            provider_token="",
            currency="XTR",
            prices=[LabeledPrice(label="Звезды", amount=stars_amount)]
        )
        return web.json_response({"invoice_url": invoice_link})

    # API для вывода подарка (Claim)
    async def claim_prize_api(request):
        data = await request.json()
        user_id = int(data.get("user_id"))
        item_uuid = data.get("uuid")
        
        user = get_user(user_id)
        target_item = None
        for item in user["inventory"]:
            if item.get("uuid") == item_uuid:
                target_item = item
                break
                
        if not target_item:
            return web.json_response({"error": "Предмет не найден!"}, status=404)
            
        if target_item.get("status") == "claimed":
            return web.json_response({"error": "Этот подарок уже выведен!"}, status=400)
            
        # Помечаем подарок как выведенный
        update_inventory_item_status(user_id, item_uuid, "claimed")
        
        # Отправляем уведомление пользователю в бот
        try:
            await bot.send_message(
                user_id,
                f"📥 **Заявка на вывод принята!**\n\n"
                f"Вы запросили вывод приза: {target_item['name']} {target_item['icon']}.\n"
                f"Администратор свяжется с вами в ближайшее время для отправки подарка!"
            )
        except Exception as e:
            print(f"Не удалось отправить сообщение пользователю: {e}")
            
        # Отправляем уведомление администратору
        try:
            username_str = f"@{user['username']}" if user['username'] else f"ID: {user_id}"
            await bot.send_message(
                ADMIN_ID,
                f"🚨 **НОВАЯ ЗАЯВКА НА ВЫВОД!**\n\n"
                f"👤 Пользователь: {username_str}\n"
                f"🎁 Приз: {target_item['name']} {target_item['icon']}\n"
                f"🆔 UUID приза: `{item_uuid}`\n\n"
                f"Свяжитесь с пользователем и отправьте ему подарок!"
            )
        except Exception as e:
            print(f"Не удалось отправить уведомление админу: {e}")
            
        return web.json_response({"success": True})


    # --- TELEGRAM BOT EVENTS ---
    @dp.message(CommandStart())
    async def cmd_start(message: types.Message):
        get_user(message.from_user.id, message.from_user.username)
        keyboard = InlineKeyboardMarkup(inline_keyboard=[
            [InlineKeyboardButton(text="Открыть Рулетку 🎰", web_app=WebAppInfo(url=f"{BASE_URL}/"))]
        ])
        await message.answer(
            f"Привет, {message.from_user.first_name}! 👋\n\n"
            "Заходи в рулетку, забирай ежедневный бесплатный приз, пополняй баланс Звёзд и выводи свои выигранные подарки!",
            reply_markup=keyboard
        )

    @dp.pre_checkout_query()
    async def pre_checkout_query_handler(pre_checkout_query: types.PreCheckoutQuery):
        await bot.answer_pre_checkout_query(pre_checkout_query.id, ok=True)

    @dp.message(F.successful_payment)
    async def successful_payment_handler(message: types.Message):
        payload = message.successful_payment.invoice_payload
        parts = payload.split("_")
        user_id = int(parts[2])
        stars_amount = int(parts[3])
        
        update_user_balance(user_id, stars_amount)
        await message.answer(f"🎉 Баланс успешно пополнен на {stars_amount} ⭐️! Открывайте рулетку и выигрывайте призы!")

    async def main():
        port = int(os.environ.get("PORT", 8080)) 
        app = web.Application()
        app.router.add_get("/", handle_index)
        app.router.add_get("/api/status", get_status_api)
        app.router.add_post("/api/spin", spin_api)
        app.router.add_post("/api/pay", create_invoice_api)
        app.router.add_post("/api/claim", claim_prize_api)
        
        runner = web.AppRunner(app)
        await runner.setup()
        site = web.TCPSite(runner, "0.0.0.0", port)
        asyncio.create_task(site.start())
        print(f"Сервер запущен на порту {port}.")

        await dp.start_polling(bot)

    if __name__ == "__main__":
        asyncio.run(main())
